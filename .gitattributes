# Normalise line endings for text, but never touch binary assets.
# Without this, core.autocrlf=true on Windows rewrites LF bytes inside PDFs,
# spreadsheets and images on checkout, corrupting them.
* text=auto

*.pdf   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.zip   binary
*.jpg   binary
*.jpeg  binary
*.JPG   binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
